# Supabase — obtén estos valores desde tu proyecto en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role (SECRETA — solo servidor, nunca NEXT_PUBLIC).
# Supabase > Settings > API > service_role. Se usa en las acciones de admin.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth — genera el hash con: node scripts/hash-password.js TU_CONTRASEÑA
AUTH_SECRET=una_clave_aleatoria_larga_y_segura
ADMIN_PASSWORD_HASH=$2b$12$...hash_generado...

# Correo — notificación del formulario "Vende tu propiedad" (Resend).
# 1. Crea cuenta gratis en https://resend.com y genera una API key.
# 2. EMAIL_TO es tu correo, donde llegan las solicitudes.
# 3. EMAIL_FROM: usa onboarding@resend.dev hasta verificar tu dominio en Resend.
# Si faltan estas variables la solicitud SÍ se guarda en la base, solo no se envía el correo.
RESEND_API_KEY=re_...
EMAIL_TO=tu_correo@ejemplo.com
EMAIL_FROM=Alarang B.R. <onboarding@resend.dev>
